{
  "name": "koin-data-logging",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "koin-log": "cli/koin-log.mjs"
  },
  "scripts": {
    "check": "node cli/koin-log.mjs check",
    "gen": "node cli/koin-log.mjs gen",
    "find": "node cli/koin-log.mjs find",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm test && node cli/koin-log.mjs gen --check && npm run check:archive",
    "check:archive": "node cli/archive.mjs",
    "workbench:dev": "npm --prefix workbench run dev",
    "workbench:build": "npm --prefix workbench run build",
    "workbench:test": "npm --prefix workbench test"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
